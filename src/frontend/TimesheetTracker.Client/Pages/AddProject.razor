@page "/addproject"
@using TimesheetTracker.Client.Services
@using TimesheetTracker.Client.Models
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@inject IApiService ApiService
@inject NavigationManager Navigation

<h3>Add Project</h3>

<EditForm Model="project" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label>Name</label>
        <InputText class="form-control" @bind-Value="project.Name" />
    </div>
    <div class="mb-3">
        <label>Description</label>
        <InputTextArea class="form-control" @bind-Value="project.Description" />
    </div>
    <div class="mb-3">
        <label>Client Name</label>
        <InputText class="form-control" @bind-Value="project.ClientName" />
    </div>
    <button type="submit" class="btn btn-primary">Add Project</button>
</EditForm>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info mt-3">@message</div>
}

@code {
    private CreateProjectRequest project = new() {
        Name = string.Empty,
        Description = string.Empty,
        ClientName = string.Empty
    };
    private string? message;

    private async Task HandleValidSubmit()
    {
        var result = await ApiService.CreateProjectAsync(project);
        if (result != null)
        {
            message = "Project added successfully!";
            Navigation.NavigateTo("/");
        }
        else
        {
            message = "Failed to add project.";
        }
    }
}
