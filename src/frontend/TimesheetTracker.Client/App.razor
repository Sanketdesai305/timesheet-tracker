
@using TimesheetTracker.Client.Layout
@using TimesheetTracker.Client.Services
@using TimesheetTracker.Client.Pages
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components

@inject IAuthenticationService AuthService

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @if (!AuthService.IsAuthenticated && routeData.PageType != null && !IsPublicRoute(routeData.PageType))
        {
            <RedirectToLogin />
        }
        else
        {
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        }
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private static readonly string[] PublicRoutes = new[] { "/", "/login", "/register" };
    private bool IsPublicRoute(Type pageType)
    {
        var routeAttrs = pageType.GetCustomAttributes(typeof(Microsoft.AspNetCore.Components.RouteAttribute), true);
        foreach (var attr in routeAttrs)
        {
            var route = ((Microsoft.AspNetCore.Components.RouteAttribute)attr).Template;
            if (PublicRoutes.Contains(route, StringComparer.OrdinalIgnoreCase))
                return true;
        }
        return false;
    }
}