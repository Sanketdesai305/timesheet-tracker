@using TimesheetTracker.Client.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@inject IAuthenticationService AuthService


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Timesheet Tracker</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <nav class="nav-scrollable sidebar-bg">
            <ul class="custom-nav">
                <li><NavLink class="custom-nav-link" href="/" Match="NavLinkMatch.All">Dashboard</NavLink></li>
                <li><NavLink class="custom-nav-link" href="/projects">Projects</NavLink></li>
                <li><NavLink class="custom-nav-link" href="/addproject">Add Project</NavLink></li>
                <li><NavLink class="custom-nav-link" href="/timeentries">Time Entries</NavLink></li>
                <li><NavLink class="custom-nav-link" href="/timer">Timer</NavLink></li>
                <li><NavLink class="custom-nav-link" href="/calendar">Calendar</NavLink></li>
                <li><NavLink class="custom-nav-link" href="/shifts">Shift Templates</NavLink></li>
                <li><NavLink class="custom-nav-link" href="/shiftinstances">Shift Instances</NavLink></li>
                <li><NavLink class="custom-nav-link" href="/holidays">Holiday Manager</NavLink></li>
                @if (AuthService.IsManager)
                {
                    <li><NavLink class="custom-nav-link" href="/approvals">Approvals</NavLink></li>
                    <li><NavLink class="custom-nav-link" href="/reports">Reports</NavLink></li>
                }
                @if (AuthService.IsAdmin)
                {
                    <li><NavLink class="custom-nav-link" href="/users">Users</NavLink></li>
                }
                @if (!AuthService.IsAuthenticated)
                {
                    <li><NavLink class="custom-nav-link" href="/login">Login</NavLink></li>
                    <li><NavLink class="custom-nav-link" href="/register">Register</NavLink></li>
                }
            </ul>
        </nav>

<style>
    .sidebar-bg {
        background: #232946 !important;
        min-height: 100vh;
        height: 100%;
        width: 100%;
    }
    .top-row {
        background: #232946 !important;
    }
    .custom-nav {
        list-style: none;
        padding-left: 0;
        margin: 0;
        background: #232946;
    }
    .custom-nav li {
        margin-bottom: 16px;
    }
    .custom-nav li:first-child {
        margin-top: 28px;
    }
    .custom-nav-link {
        text-decoration: none !important;
        color: #eaeaea;
        font-size: 1.08rem;
        padding: 8px 18px;
        border-radius: 6px;
        display: block;
        border: 1px solid transparent;
        transition: background 0.2s, color 0.2s, border 0.2s;
        background: #232946;
    }
    .custom-nav-link.active, .custom-nav-link:active, .custom-nav-link:focus {
        background: #393e6c;
        color: #fff;
        border: 1px solid #393e6c;
        text-decoration: none;
    }
    .custom-nav-link:hover {
        background: #393e6c;
        color: #fff;
        border: 1px solid #393e6c;
        text-decoration: none;
    }
</style>
    </div>
</div>


@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override void OnInitialized()
    {
        AuthService.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    private void OnAuthenticationStateChanged(bool isAuthenticated)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        AuthService.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
