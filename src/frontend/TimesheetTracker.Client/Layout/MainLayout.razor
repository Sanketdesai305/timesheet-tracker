@using TimesheetTracker.Client.Layout
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
<style>
    .top-row {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        min-height: 56px;
        gap: 32px;
    }
    .user-info {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-right: 24px;
    }
    .user-name, .user-role {
        color: #fff;
        font-weight: 500;
        margin-right: 0;
    }
    .icon-group {
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
    }
    .profile-dropdown {
        position: relative;
        display: flex;
        align-items: center;
        height: 100%;
        min-width: 48px;
        justify-content: center;
    }
    .dropdown-menu {
        display: none;
        position: absolute;
        right: 0;
        top: calc(100% + 8px);
        background: #232946;
        min-width: 220px;
        max-width: 260px;
        box-shadow: 0 8px 16px rgba(0,0,0,0.15);
        z-index: 1000;
        border-radius: 8px;
        padding: 8px 0;
        margin-top: 0;
    }
    .dropdown-menu.show {
        display: block;
    }
    .dropdown-item {
        color: #fff;
        padding: 8px 20px;
        text-decoration: none;
        display: flex;
        align-items: center;
        background: none;
        border: none;
        width: 100%;
        text-align: left;
        cursor: pointer;
        font-size: 1rem;
        transition: background 0.2s;
        word-break: break-word;
        white-space: normal;
        line-height: 1.4;
    }
    .dropdown-item:hover {
        background: #393e6c;
    }
    .dropdown-item svg {
        margin-right: 10px;
        vertical-align: middle;
        display: inline-block;
    }
    .icon-link {
        color: #fff;
        margin-left: 8px;
        transition: color 0.2s;
        text-decoration: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        display: inline-flex;
        align-items: center;
    }
    .icon-link:hover, .icon-link:focus {
        color: #e0e0e0;
        outline: none;
    }
    .logout-btn {
        margin-left: 8px;
    }
</style>
@using TimesheetTracker.Client.Services
@using Microsoft.JSInterop
@namespace TimesheetTracker.Client.Layout

@inherits LayoutComponentBase
@inject IAuthenticationService AuthService

@code {
    private bool authInitialized = false;
    private bool profileDropdownOpen = false;
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private IJSObjectReference? _jsModule;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./closeDropdown.js");
            if (_jsModule != null)
            {
                await _jsModule.InvokeVoidAsync("registerDropdownClose", _dotNetRef);
            }
        }
    }

    [JSInvokable]
    public void CloseProfileDropdown()
    {
        if (profileDropdownOpen)
        {
            profileDropdownOpen = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await AuthService.InitializeAsync();
        authInitialized = true;
        StateHasChanged();
    }

    private void OnAuthenticationStateChanged(bool isAuthenticated)
    {
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        await JSRuntime.InvokeVoidAsync("customLogout");
    }

    private void ToggleProfileDropdown()
    {
        profileDropdownOpen = !profileDropdownOpen;
    }

    public async ValueTask DisposeAsync()
    {
        AuthService.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        if (_jsModule != null)
        {
            await _jsModule.InvokeVoidAsync("disposeDropdownClose");
            await _jsModule.DisposeAsync();
        }
        _dotNetRef?.Dispose();
    }
}

@if (!authInitialized)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading authentication...</span>
        </div>
    </div>
}
else
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row px-4">
                @if (AuthService.IsAuthenticated)
                {
                    <div class="user-info">
                        <span class="user-name">Welcome, @AuthService.CurrentUser?.FirstName @AuthService.CurrentUser?.LastName</span>
                        <span class="user-role">(@AuthService.CurrentUser?.Role)</span>
                    </div>
                    <span class="icon-group">
                        <a href="/notifications" title="Notifications" class="icon-link">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="#fff" viewBox="0 0 24 24"><path d="M12 24c1.104 0 2-.896 2-2h-4c0 1.104.896 2 2 2zm6.364-6v-5c0-3.07-1.639-5.64-4.364-6.32V6c0-.828-.672-1.5-1.5-1.5S11 5.172 11 6v.68C8.275 7.36 6.636 9.93 6.636 13v5l-1.636 1.636V21h16v-1.364L18.364 18zM18 19H6v-.364l1.636-1.636V13c0-2.757 1.243-5 4.364-5s4.364 2.243 4.364 5v4.636L18 18.636V19z"/></svg>
                        </a>
                        <span class="profile-dropdown">
                            <a href="#" title="Profile" class="icon-link" @onclick="ToggleProfileDropdown" @onclick:preventDefault="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="#fff" viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8V22h19.2v-2.8c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
                            </a>
                            <div class="dropdown-menu @(profileDropdownOpen ? "show" : "")">
                                <button class="dropdown-item" type="button" onclick="window.open('mailto:support@timesheettracker.com','_blank')">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#fff" viewBox="0 0 24 24"><path d="M12 13.065l-8-5.065v10h16v-10l-8 5.065zm8-7.065h-16l8 5.065 8-5.065z"/></svg>
                                    Help / Support
                                </button>
                                <button class="dropdown-item" @onclick="LogoutAsync">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#fff" viewBox="0 0 24 24"><path d="M16 13v-2H7V8l-5 4 5 4v-3zM20 3h-8c-1.1 0-2 .9-2 2v4h2V5h8v14h-8v-4h-2v4c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/></svg>
                                    Logout
                                </button>
                            </div>
                        </span>
                    </span>
// ...existing code...
                }
                else
                {
                    <a href="login" class="btn btn-primary">Login</a>
                }
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>


